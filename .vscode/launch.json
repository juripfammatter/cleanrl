    "version": "0.2.0",
    "configurations": [

        {
            "name": "Python Debugger: Train",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "--seed 42 --env-id CartPole-v0 --total-timesteps 50000"
        },
        {
            "name": "Python Debugger: Eval",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "args": "--seed 42 --env-id CartPole-v0 --eval_iterations 12000"
        }
    ]
}